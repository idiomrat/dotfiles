#!/bin/sh
# Reruns only when dot_config/packfile's content changes.
# hash: {{ include "dot_config/packfile" | sha256sum }}
set -e

echo "packfile changed — running packctl apply..."

# Initialize an empty variable for the purge flag
PURGE_FLAG=""

# Prompt the user for input
printf "Do you want to run with --purge? (y/N): "
read -r response

# Check the response (accepts 'y' or 'Y')
if [ "$response" = "y" ] || [ "$response" = "Y" ]; then
    PURGE_FLAG="--purge"
fi

# Run the command with the optional flag included
packctl apply $PURGE_FLAG
