{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "padding": {
      "top": 1,
      "left": 1,
      "right": 2
    },
    "color": {
      "1": "#aaaaff",
      "2": "#aaaaff",
      "3": "#aaaaff",
      "4": "#aaaaff",
      "5": "#aaaaff",
      "6": "#aaaaff"
    }
  },
  "display": {
    "separator": " ➜ ",
    "color": {
      "keys": "#aaaaff",
      "title": "#aaaaff"
    }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "wm",
    "cpu",
    {
      "type": "memory",
      "percent": {
        "type": 1
      }
    },
    "break"
  ]
}
